    {
        "id": "b9b982e625840544",
        "type": "function",
        "z": "970ef5208cac7ab6",
        "name": "function 2",
        "func": "// Generate randomized mock values for your safety dashboard\nvar temp = (Math.random() * 15 + 20).toFixed(1);       // 20.0 to 35.0 °C\nvar humidity = (Math.random() * 30 + 30).toFixed(1);   // 30 to 60 %\nvar ch4 = Math.floor(Math.random() * 400 + 100);       // 100 to 500 ppm\nvar co = Math.floor(Math.random() * 20 + 5);           // 5 to 25 ppm\n\n// Output a single object payload\nmsg.payload = {\n    temp: Number(temp),\n    humidity: Number(humidity),\n    ch4: Number(ch4),\n    co: Number(co),\n    flame: \"NORMAL\"\n};\n\nreturn msg;\nreturn msg;",
